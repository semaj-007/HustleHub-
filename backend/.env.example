NODE_ENV=development
PORT=8443
# npm run setup generates a random local secret. Never commit the generated .env.
JWT_SECRET=replace_this_with_a_long_random_secret_before_running
JWT_EXPIRES_IN=1h
JWT_ISSUER=hustlehub-plus-api
HTTPS_KEY_PATH=./certs/key.pem
HTTPS_CERT_PATH=./certs/cert.pem
CORS_ORIGIN=https://localhost:5173
USER_STORE_PATH=./src/data/users.json
MARKETPLACE_STORE_PATH=./src/data/marketplace.json
BCRYPT_SALT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_WINDOW_MS=900000
BOOKING_RATE_LIMIT_MAX=20
